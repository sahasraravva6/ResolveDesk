# Use MySQL for shared/production application data. Leave blank for local SQLite demo mode.
# Leave blank for local SQLite. Configure a reachable MySQL URL for shared use.
DATABASE_URL=
SECRET_KEY=replace-with-a-long-random-value

# Hindsight service. Local demo mode is used when HINDSIGHT_BASE_URL is blank.
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=resolvedesk-demo

# Optional OpenAI-compatible chat completions endpoint. Without a key, responses use the safe demo generator.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
